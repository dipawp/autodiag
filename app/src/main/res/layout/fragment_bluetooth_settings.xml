<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!--
        Intestazione della schermata Bluetooth.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/textViewBluetoothTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bluetooth"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Dispositivi associati"
            android:textSize="14sp" />

    </LinearLayout>

    <!--
        Messaggio visualizzato quando non è possibile
        mostrare la lista.
    -->
    <TextView
        android:id="@+id/textViewBluetoothEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:padding="24dp"
        android:gravity="center"
        android:text="Nessun dispositivo Bluetooth associato"
        android:textSize="16sp" />

    <!--
        Lista dei dispositivi Bluetooth associati.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBluetoothDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone" />

</LinearLayout>
